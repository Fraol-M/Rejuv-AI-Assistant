# For lighter tasks 
BASIC_LLM_PROVIDER=openai  # 'openai' or 'gemini'
BASIC_LLM_VERSION=gpt-3.5-turbo  # 'gpt-3.5-turbo', 'gemini-lite', etc.

# For complex, resource-intensive tasks
ADVANCED_LLM_PROVIDER=openai  # 'openai' or 'gemini'
ADVANCED_LLM_VERSION=gpt-4o  # 'gpt-4o', 'gemini-pro', etc.

# API keys for each provider
OPENAI_API_KEY=<your openai api key>
GEMINI_API_KEY=<your gemini api key>
E2B_API_KEY=<your e2b api key>
# E2B_Sandbox_KEY is also supported as an alias for E2B_API_KEY

# LangSmith tracing and per-query LLM usage reporting.
# Token counts are always reported in API responses when LLM calls run through the shared wrapper.
# Set these to also send traces to LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<your langsmith api key>
LANGSMITH_PROJECT=rejuv-ai-assistant

# Optional model pricing, in USD per 1M tokens, used only for estimated_cost_usd.
# Replace/add entries for the exact provider+model names configured above.
LLM_COST_OPENAI_GPT_4O_INPUT_PER_1M=0
LLM_COST_OPENAI_GPT_4O_OUTPUT_PER_1M=0
LLM_COST_OPENAI_GPT_3_5_TURBO_INPUT_PER_1M=0
LLM_COST_OPENAI_GPT_3_5_TURBO_OUTPUT_PER_1M=0

# Action sandbox execution: E2B first, hardened local Docker fallback for development.
# Mounting the Docker socket gives the assistant powerful host-level Docker access;
# for production, prefer E2B or a dedicated sandbox worker/daemon boundary.
ACTION_SANDBOX_BACKEND=e2b
ACTION_SANDBOX_FALLBACK=docker
ACTION_SANDBOX_DOCKER_IMAGE=rejuv-action-sandbox:latest
ACTION_SANDBOX_DOCKER_NETWORK=none
ACTION_SANDBOX_DOCKER_TIMEOUT=120
ACTION_SANDBOX_DOCKER_MEMORY=1g
ACTION_SANDBOX_DOCKER_CPUS=1
ACTION_SANDBOX_DOCKER_PIDS_LIMIT=256
ACTION_SANDBOX_DOCKER_USER=sandbox
ACTION_SANDBOX_DOCKER_TMP_SIZE=100m
ACTION_SANDBOX_DOCKER_WORKDIR_SIZE=512m
ACTION_SANDBOX_ALLOW_DOCKER_INTERNET=false

NEO4J_URI=<neo4j uri>
NEO4J_USERNAME=<neo4j username>
NEO4J_PASSWORD=<neo4j password>

JWT_SECRET=<jwt token used for authentication service>
ANNOTATION_SERVICE_URL=<http://localhost:5000/query?limit=100 & properties=true>
FLASK_PORT=5002
BIOGPT_THREADS=1  # Number of CPU threads for BioGPT inference (increase for faster generation on powerful CPUs)

QDRANT_CLIENT=http://localhost:6333

- in __init__.py, Change the embedding_model variable to:
    - openai_embedding_model to use openai embedding models
    - gemini_embedding_model to use gemini embedding models
    - sentence_transformer_embedding_model to use sentence transformer embedding

MONGO_USERNAME=admin
MONGO_PASSWORD=<your_password_here>
MONGO_DATABASE=ai_assistant
MONGO_URL=mongodb://admin:<your_password_here>@mongodb:27017/
